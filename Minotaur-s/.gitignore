# Ignorar o projeto gerado pelo XcodeGen
*.xcodeproj

# Ignorar dados de build do Xcode
DerivedData/
build/

# Ignorar arquivos temporários
*.xcurserdata

# Modelos Core ML: os weight.bin (109 MB e 118 MB) passam do limite de 100 MB por arquivo do GitHub,
# então são versionados fatiados em model-parts/ (partes de 45 MiB) e remontados por
# scripts/sync-models.sh (roda sozinho na build). Só o weight.bin remontado é ignorado.
Minotaur-s/Resources/Models/**/weights/weight.bin

# Dependências do Worker (proxy/), caso alguém rode npm install localmente
proxy/node_modules/
proxy/.wrangler/